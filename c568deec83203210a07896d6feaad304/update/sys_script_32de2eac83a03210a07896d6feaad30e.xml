        <script><![CDATA[(function executeRule(current, previous /*null when async*/ ) {

    if (current.assigned_to) return; // déjà assigné
    var scorer = new AssignmentScorer();
    var best = scorer.findBestAssignee(current);
    if (best) {
        current.assigned_to = best.user;
        current.recommended_assignee = best.user;
        current.assignment_score = best.score;
        current.model_version = 'rule_v1';
        current.update();
    }

})(current, previous);]]></script>
